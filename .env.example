# Database Configuration
# For local development with Docker:
DATABASE_URL="postgresql://planova:planova123@localhost:5432/planova_dev"

# For production (Vercel Postgres, Supabase, Railway, etc.):
# DATABASE_URL="postgresql://username:password@host:port/database"

# Direct (non-pooled) connection — used by Prisma for migrations.
# Required when DATABASE_URL points at a connection pooler (e.g. Supabase pgbouncer).
# DIRECT_URL="postgresql://username:password@host:port/database"

# API Base URL for client-side requests
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
# AUTH_SECRET signs/encrypts the session JWT. NEXTAUTH_SECRET is still read as a
# fallback by auth.ts, middleware.ts and server.js.
AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
# NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Socket.io server (server.js) — run with `npm run dev-socket`
# Port the socket server listens on
SOCKET_PORT=3001
# Shared secret required on POST /emit (x-socket-secret header) — server-side
# code uses it to push realtime events. Generate with: openssl rand -hex 32
SOCKET_SECRET=your-socket-secret-here
# Server-side URL of the socket server (used by API routes to relay events)
SOCKET_URL=http://localhost:3001
# Allowed browser origin for socket connections (session cookies are required)
SOCKET_CORS_ORIGIN=http://localhost:3000
# Browser-side URL of the socket server
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# GitHub OAuth (Optional - configure when needed)
# Set to 'true' to enable GitHub OAuth button
NEXT_PUBLIC_GITHUB_ENABLED=false
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-app-secret
